# Required
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_PROXY=

# LLM
G4F_MODEL=gpt-4o-mini
G4F_PROXY=
G4F_PROVIDER_ORDER=PollinationsAI,DeepInfra,HuggingChat,You,Auto
G4F_WEB_SEARCH=false
LLM_TIMEOUT=60
LLM_MAX_RETRIES=5

# Memory
HISTORY_LAST_N=10
RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHARS=6000
TELEGRAM_MAX_MESSAGE_CHARS=3500

# DB
DB_PATH=database/sqlite.db
